*.pyc
*.pyo
*.pyd
.Python
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
.venv
venv
.git
.gitignore
.env
.env.*
*.pem
*.key
.DS_Store
node_modules
tests/__pycache__
test_reports
*.log
