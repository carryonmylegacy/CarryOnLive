  "scripts": {
    "start": "craco start",
    "build": "node scripts/prebuild-sw-version.js && node -e \"const fs=require('fs');fs.writeFileSync('public/version.json',JSON.stringify({v:Date.now().toString(36)}));fs.copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs');fs.copyFileSync('node_modules/react-pdf/node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.react-pdf.min.mjs');\" && CI=false craco build",
    "test": "craco test",
    "lint": "eslint src/ --ext .js,.jsx --max-warnings 50",
    "lint:fix": "eslint src/ --ext .js,.jsx --fix",
    "lint:errors": "eslint src/ --ext .js,.jsx --quiet",
    "e2e": "playwright test --project=smoke-chromium --project=smoke-mobile",
    "e2e:prod-safe": "playwright test --project=smoke-chromium --project=smoke-mobile --grep-invert 'Revenue funnel'",
    "e2e:visual": "playwright test --project=visual",
    "e2e:ui": "playwright test --ui",
    "e2e:smoke:desktop": "playwright test --project=smoke-chromium tests/e2e/smoke.spec.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "plugins": [
      "unused-imports"
    ],
    "rules": {
      "no-unused-vars": "off",
      "unused-imports/no-unused-imports": "warn",
      "unused-imports/no-unused-vars": [
        "warn",
        {
          "vars": "all",
          "varsIgnorePattern": "^_",
          "args": "after-used",
          "argsIgnorePattern": "^_",
          "caughtErrors": "all",
          "caughtErrorsIgnorePattern": "^_"
        }
      ],
      "import/first": "warn"
    }
  },
