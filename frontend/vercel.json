{
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "installCommand": "bash vercel-install.sh",
  "buildCommand": "chmod +x build-prod.sh && bash build-prod.sh",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/:path*", "destination": "/shell.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "app.carryon.us" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
