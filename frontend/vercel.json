{
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "installCommand": "bash vercel-install.sh",
  "buildCommand": "chmod +x build-prod.sh && bash build-prod.sh",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/accept-invitation/:path*", "destination": "/index.html" },
    { "source": "/signup", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/onboarding", "destination": "/index.html" },
    { "source": "/vault", "destination": "/index.html" },
    { "source": "/messages", "destination": "/index.html" },
    { "source": "/messages/:path*", "destination": "/index.html" },
    { "source": "/guardian", "destination": "/index.html" },
    { "source": "/checklist", "destination": "/index.html" },
    { "source": "/beneficiaries", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/security-settings", "destination": "/index.html" },
    { "source": "/support", "destination": "/index.html" },
    { "source": "/trustee", "destination": "/index.html" },
    { "source": "/transition", "destination": "/index.html" },
    { "source": "/digital-wallet", "destination": "/index.html" },
    { "source": "/timeline", "destination": "/index.html" },
    { "source": "/subscription", "destination": "/index.html" },
    { "source": "/create-estate", "destination": "/index.html" },
    { "source": "/ffn", "destination": "/index.html" },
    { "source": "/founder-about", "destination": "/index.html" },
    { "source": "/founder-about/:path*", "destination": "/index.html" },
    { "source": "/founder", "destination": "/index.html" },
    { "source": "/voices", "destination": "/index.html" },
    { "source": "/partner-brief", "destination": "/index.html" },
    { "source": "/beneficiary/:path*", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/ops/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
